PORT=3100
HOST=127.0.0.1
NAUCTO_BACKEND_URL=http://localhost:3000
# Exact Host headers (host:port) this service answers to. Requests with an Origin are refused.
NAUCTO_MCP_HOSTS=localhost:3100,127.0.0.1:3100
# Shared with the Backend's AI_SERVICE_SECRET; only this service may store generation results.
AI_SERVICE_SECRET=
NAUCTO_GENERATION_CONCURRENCY=2
# Version-matched engine documentation built by the Frontend (npm run docs:build).
NAUCTO_ENGINE_DOCS=../Frontend/apps/web/public/docs/index.json
# Optional specialist endpoints (HTTPS, contract in providers/README.md). A generator is enabled
# only when its endpoint and model identifier are set together with HF_TOKEN.
HF_TOKEN=
HF_SPRITE_ENDPOINT=
HF_SPRITE_MODEL=
HF_MIDI_ENDPOINT=
HF_MIDI_MODEL=
HF_SAMPLE_ENDPOINT=
HF_SAMPLE_MODEL=
