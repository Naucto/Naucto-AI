PORT=3100
HOST=127.0.0.1
NAUCTO_BACKEND_URL=http://localhost:3000
# Exact Host headers (host:port) this service answers to. Requests with an Origin are refused.
NAUCTO_MCP_HOSTS=localhost:3100,127.0.0.1:3100
# Shared with the Backend's AI_SERVICE_SECRET; only this service may store generation results.
AI_SERVICE_SECRET=
NAUCTO_GENERATION_CONCURRENCY=2

# ---- Credentials ----
# Clients normally send their own credential as `Authorization: Bearer …`: the account's assistant
# key (naucto_k_…), created in Settings → Assistant. It reaches every project the account owns, so a
# client working on several also sends X-Naucto-Project (or calls use_project).
#
# NAUCTO_KEY is a fallback for a single-user local setup, for a client that cannot hold a credential
# of its own. It is only accepted when the request carries no Authorization header at all, and the
# service refuses to start with it set unless HOST is loopback: on a public bind, anything that can
# reach the port may send any Host header, so lending the key would hand over the owner's projects.
NAUCTO_KEY=
# Which of the account's projects the fallback key starts on. Ignored when the client sends its own hint.
NAUCTO_PROJECT=
# Version-matched engine documentation built by the Frontend (npm run docs:build).
NAUCTO_ENGINE_DOCS=../Frontend/apps/web/public/docs/index.json

# ---- PixelLab sprite drafts (paid credits); unset = generation disabled ----
PIXELLAB_TOKEN=
PIXELLAB_API_URL=https://api.pixellab.ai/v2
# PixelLab draws at no less than this size; the result is downsampled onto the sprite's own.
PIXELLAB_MIN_SIZE=32
